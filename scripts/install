#!/bin/sh

set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$SCRIPT_DIR/lib/common.sh"

PROFILE=release
APP_DIR=${KINETIC_APP_DIR:-"$HOME/Applications"}
BIN_DIR=${KINETIC_BIN_DIR:-"$HOME/.local/bin"}

if [ "${1:-}" = "--debug" ]; then
    PROFILE=debug
elif [ "${1:-}" != "" ] && [ "${1:-}" != "--release" ]; then
    kinetic_die "usage: ./scripts/install [--debug|--release]"
fi

"$SCRIPT_DIR/build" "--$PROFILE"

SOURCE_APP="$(kinetic_build_dir "$PROFILE")/Kinetic.app"
TARGET_APP="$APP_DIR/Kinetic.app"
TARGET_CLI="$BIN_DIR/kinetic"

[ ! -e "$TARGET_APP" ] || kinetic_die "$TARGET_APP already exists; run ./scripts/uninstall first"
if [ -e "$TARGET_CLI" ] && [ ! -L "$TARGET_CLI" ]; then
    kinetic_die "$TARGET_CLI exists and is not a symlink"
fi

mkdir -p "$APP_DIR" "$BIN_DIR"
ditto "$SOURCE_APP" "$TARGET_APP"
ln -sfn "$TARGET_APP/Contents/Resources/bin/kinetic" "$TARGET_CLI"

printf 'Installed %s\n' "$TARGET_APP"
printf 'Linked CLI at %s\n' "$TARGET_CLI"

