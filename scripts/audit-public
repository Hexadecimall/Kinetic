#!/bin/sh

set -eu
scriptDir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$scriptDir/lib/common.sh"

if rg -n --hidden --glob '!build/**' --glob '!dist/**' --glob '!.git/**' \
    --glob '!scripts/audit-public' \
    '(/Users/|/Volumes/)' "$KINETIC_ROOT"; then
    kinetic_die "audit found private paths"
else
    if which rg > /dev/null; then
        echo "audit passed"
    else
        kineticDie "Ripgrep is not installed."
    fi
fi
