#!/bin/sh

set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$SCRIPT_DIR/lib/common.sh"

[ "$("$SCRIPT_DIR/version" next patch 0.9.99)" = "0.10.0" ] ||
    kinetic_die "patch rollover failed"
[ "$("$SCRIPT_DIR/version" next feature 0.99.42)" = "1.0.0" ] ||
    kinetic_die "feature rollover failed"
[ "$("$SCRIPT_DIR/version" next patch 0.99.99)" = "1.0.0" ] ||
    kinetic_die "major rollover failed"
if "$SCRIPT_DIR/version" next patch 0.100.0 >/dev/null 2>&1; then
    kinetic_die "feature cap validation failed"
fi

"$SCRIPT_DIR/build" --debug

CARGO_TARGET_DIR="$KINETIC_ROOT/build/cargo-tests" cargo test --workspace --all-targets
ctest --test-dir "$(kinetic_build_dir debug)" --output-on-failure
