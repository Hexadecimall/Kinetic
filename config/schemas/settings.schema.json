{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinetic.frameworksdev.top/schemas/settings-v1.json",
  "title": "Kinetic settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "plugins": { "$ref": "#/$defs/plugins" },
    "window": { "$ref": "#/$defs/window" },
    "animations": { "$ref": "#/$defs/animations" },
    "editor": { "$ref": "#/$defs/editor" },
    "autocomplete": { "$ref": "#/$defs/autocomplete" },
    "activityBar": { "$ref": "#/$defs/activityBar" },
    "search": { "$ref": "#/$defs/search" },
    "recent": { "$ref": "#/$defs/recent" },
    "fileBrowser": { "$ref": "#/$defs/fileBrowser" },
    "shortcuts": { "$ref": "#/$defs/shortcuts" }
  },
  "required": ["schemaVersion"],
  "$defs": {
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "disabledFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 7 }
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opacity": { "type": "number", "minimum": 0.1, "maximum": 1.0 },
        "backdropBlur": { "type": "boolean" },
        "minimumWidth": { "type": "integer", "minimum": 320 },
        "minimumHeight": { "type": "integer", "minimum": 240 }
      }
    },
    "animations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "easing": { "type": "string" },
        "editorEnterMilliseconds": { "type": "integer", "minimum": 0 },
        "editorExitMilliseconds": { "type": "integer", "minimum": 0 },
        "modalMilliseconds": { "type": "integer", "minimum": 0 },
        "settingsPanelMilliseconds": { "type": "integer", "minimum": 80, "maximum": 400 }
      }
    },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontSize": { "type": "number", "minimum": 6.0 },
        "fontPreset": { "type": "integer", "minimum": 0, "maximum": 3 },
        "letterSpacing": { "type": "number", "minimum": -2.0, "maximum": 8.0 },
        "highlightCurrentLine": { "type": "boolean" },
        "showDiagnostics": { "type": "boolean" },
        "lineHeight": { "type": "number", "minimum": 8.0 },
        "tabWidth": { "type": "integer", "minimum": 1, "maximum": 16 },
        "insertTabs": { "type": "boolean" },
        "autoIndent": { "type": "boolean" },
        "indentUnitNavigation": { "type": "boolean" },
        "showIndentGuides": { "type": "boolean" },
        "autoPairs": { "type": "boolean" },
        "verticalScrolling": { "type": "boolean" },
        "horizontalScrolling": { "type": "boolean" },
        "showScrollIndicators": { "type": "boolean" },
        "naturalScrolling": { "type": "boolean" },
        "showLineNumbers": { "type": "boolean" },
        "syntaxHighlighting": { "type": "boolean" },
        "showDirtyIndicator": { "type": "boolean" },
        "tabMinimumWidth": { "type": "number", "minimum": 48.0 },
        "tabMaximumWidth": { "type": "number", "minimum": 72.0 },
        "mouseCaretPlacement": { "type": "boolean" },
        "mouseDragSelection": { "type": "boolean" },
        "shiftClickExtendsSelection": { "type": "boolean" },
        "contextMenu": { "type": "boolean" },
        "undoHistoryLimit": { "type": "integer", "minimum": 0 },
        "optionWordNavigation": { "type": "boolean" }
      }
    },
    "autocomplete": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minPrefix": { "type": "integer", "minimum": 1, "maximum": 8 },
        "maxResults": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "activityBar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visible": { "type": "boolean" },
        "railWidth": { "type": "number", "minimum": 28.0 },
        "panelWidth": { "type": "number", "minimum": 140.0 },
        "defaultSection": {
          "enum": ["none", "explorer", "sourceControl", "plugins", "settings"]
        },
        "animationMilliseconds": { "type": "integer", "minimum": 0 },
        "collapseAnimationMilliseconds": { "type": "integer", "minimum": 0 },
        "sectionHeaders": { "type": "boolean" },
        "preserveSectionAcrossTabs": { "type": "boolean" },
        "showExplorer": { "type": "boolean" },
        "showHiddenFiles": { "type": "boolean" },
        "showSourceControl": { "type": "boolean" },
        "showPlugins": { "type": "boolean" },
        "showSettings": { "type": "boolean" }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showButton": { "type": "boolean" },
        "defaultScope": { "enum": ["file", "project"] },
        "popoverWidth": { "type": "number", "minimum": 220.0 },
        "maximumResults": { "type": "integer", "minimum": 1 },
        "animationMilliseconds": { "type": "integer", "minimum": 0 }
      }
    },
    "recent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persistProjects": { "type": "boolean" },
        "maximumProjects": { "type": "integer", "minimum": 0, "maximum": 50 },
        "showParentPath": { "type": "boolean" }
      }
    },
    "fileBrowser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rowHeight": { "type": "number", "minimum": 18.0 },
        "naturalScrolling": { "type": "boolean" },
        "foldersFirst": { "type": "boolean" },
        "showHiddenFiles": { "type": "boolean" }
      }
    },
    "shortcuts": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
