# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem 1.0

name                kinetic
version             @VERSION@
revision            0
categories          editors aqua
platforms           {darwin any}
supported_archs     arm64
license             Apache-2
maintainers         nomaintainer

description         A macOS code editor with Rust/C++ plugin support
long_description    Kinetic is a code editor with a custom macOS interface, \
                    project navigation, language tooling, and native plugins.
homepage            https://github.com/Hexadecimall/Kinetic

master_sites        https://github.com/Hexadecimall/Kinetic/releases/download/v${version}/
distname            Kinetic-${version}-macos-arm64
use_zip             yes
worksrcdir          .

checksums           rmd160 @RMD160@ \
                    sha256 @SHA256@ \
                    size @SIZE@

use_configure       no
build               {}

destroot {
    xinstall -d ${destroot}${applications_dir}
    copy ${worksrcpath}/Kinetic.app ${destroot}${applications_dir}

    xinstall -d ${destroot}${prefix}/bin
    ln -s ${applications_dir}/Kinetic.app/Contents/Resources/bin/kinetic \
        ${destroot}${prefix}/bin/kinetic
}

if {${os.platform} ne "darwin" || ${os.major} < 24} {
    known_fail yes
    pre-fetch {
        ui_error "Kinetic @${version} requires macOS 15 or newer"
        return -code error "incompatible macOS version"
    }
}

livecheck.type      regex
livecheck.url       https://github.com/Hexadecimall/Kinetic/releases
livecheck.regex     {Kinetic-(\d+(?:\.\d+)*)-macos-arm64\.zip}
